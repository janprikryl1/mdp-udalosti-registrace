# Database connection strings (PostgreSQL / Neon / Vercel Postgres)
POSTGRES_PRISMA_URL="postgresql://postgres:password@localhost:5432/qr_entry?sslmode=prefer"
POSTGRES_URL_NON_POOLING="postgresql://postgres:password@localhost:5432/qr_entry?sslmode=prefer"

# Brevo API key for sending confirmation emails with QR codes
BREVO_API_KEY="your-brevo-api-key"

# Sender email address
EMAIL_FROM="Církevní Silvestr <tickets@example.com>"

# Organizer password for accessing /checkin terminal
ADMIN_PASSWORD="change-me-to-a-secure-password"

# Secret key for signing organizer session JWT cookies (minimum 32 characters)
AUTH_SECRET="your-secure-random-auth-secret-key-min-32-chars-long"

# Public application URL (used for links in emails and QR code validation)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
